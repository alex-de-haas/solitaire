{
  "schemaVersion": "hosty-publisher.0.1",
  "metadataBranch": "app-releases",
  "sourceBranch": "main",
  "feeds": [
    {
      "id": "daily",
      "label": "Daily",
      "policy": "validated-source",
      "default": true
    },
    {
      "id": "stable",
      "label": "Stable",
      "policy": "manual-promotion"
    }
  ],
  "apps": [
    {
      "id": "com.haas.solitaire",
      "manifest": "manifest.json",
      "profiles": [
        "docker"
      ],
      "sourceInputs": [
        "manifest.json",
        "assets",
        "public",
        "docs/store.md",
        "skills"
      ],
      "sourceReusable": false
    }
  ],
  "images": [
    {
      "id": "solitaire",
      "appId": "com.haas.solitaire",
      "services": [
        "web"
      ],
      "repository": "ghcr.io/alex-de-haas/solitaire",
      "context": ".",
      "dockerfile": "Dockerfile",
      "inputs": [],
      "platforms": [
        "linux/amd64",
        "linux/arm64"
      ],
      "reusable": true,
      "reuseConstraint": "Digest-pinned Node base and dependency-free offline build.",
      "toolchain": {
        "buildkit": "docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc",
        "contextFormat": "hosty-build-inputs.0.1"
      },
      "resolveBases": {
        "NODE_IMAGE": {
          "repository": "node",
          "tag": "24-alpine"
        }
      }
    }
  ]
}
