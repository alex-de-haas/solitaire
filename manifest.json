{
  "schemaVersion": "app.0.1",
  "id": "com.haas.solitaire",
  "name": "Solitaire",
  "description": "A calm, tactile game of draw-one Klondike solitaire.",
  "version": "0.3.1",
  "source": {
    "type": "git",
    "repository": "https://github.com/alex-de-haas/solitaire.git",
    "branch": "main"
  },
  "runtimeProfiles": [
    {
      "key": "docker",
      "type": "docker",
      "default": true
    },
    {
      "key": "dev",
      "type": "localCommand",
      "development": true
    }
  ],
  "defaultRuntime": "docker",
  "services": [
    {
      "key": "web",
      "runtimes": {
        "dev": {
          "type": "localCommand",
          "workingDirectory": ".",
          "setup": "npm run build",
          "command": "npm start",
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ]
        },
        "docker": {
          "type": "docker",
          "image": {
            "repository": "ghcr.io/alex-de-haas/solitaire",
            "tag": "latest"
          },
          "ports": [
            {
              "key": "http",
              "containerPort": 3000,
              "protocol": "http",
              "public": true
            }
          ],
          "healthcheck": {
            "type": "exec",
            "command": "node -e \"fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
            "intervalSeconds": 30,
            "timeoutSeconds": 5,
            "retries": 3,
            "gracePeriodSeconds": 5
          }
        }
      }
    }
  ],
  "endpoints": [
    {
      "key": "http",
      "service": "web",
      "port": "http",
      "protocol": "http",
      "public": true
    }
  ],
  "ui": {
    "category": "Games",
    "icon": "spade",
    "entrypoint": {
      "endpoint": "http",
      "path": "/"
    },
    "navigation": [
      {
        "label": "Play",
        "path": "/",
        "endpoint": "http",
        "iconAsset": "public/icon.svg"
      }
    ]
  },
  "capabilities": ["logs"],
  "catalogMetadata": {
    "publisher": {
      "name": "Haas",
      "url": "https://github.com/alex-de-haas",
      "email": "a.zayats@outlook.com"
    },
    "category": "Games",
    "tags": ["cards", "klondike", "offline"],
    "icon": "public/icon.svg",
    "license": "MIT",
    "links": {
      "website": "https://github.com/alex-de-haas/solitaire",
      "docs": "https://github.com/alex-de-haas/solitaire/blob/main/docs/root.md"
    },
    "summary": "A focused draw-one Klondike game designed for Hosty Shell.",
    "descriptionFile": "docs/store.md"
  }
}
